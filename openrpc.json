{
  "openrpc": "1.4.1",
  "info": {
    "title": "ReaSock",
    "version": "0.2.0",
    "description": "JSON-RPC 2.0 over WebSocket between REAPER and outside programs. Each running REAPER announces itself in `~/.reasock/instances/<pid>.json`. After connecting, a client must call `initialize` before anything else except `rpc.discover`. Params are always by name. Messages the server sends to clients on its own (registered actions running, and subscribed events) are listed under `x-notifications`.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "name": "local",
      "url": "ws://127.0.0.1:{port}",
      "summary": "A REAPER instance on this machine",
      "variables": {
        "port": {
          "default": "9670",
          "description": "Read the actual port from the instance file."
        }
      }
    }
  ],
  "methods": [
    {
      "name": "initialize",
      "summary": "Start a session",
      "description": "Must be the first call on a connection. The server always answers with its own `protocolVersion`; if that differs from the client's, the client decides whether to continue. `client.name` namespaces everything this connection registers.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "protocolVersion",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "client",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ClientInfo"
          }
        },
        {
          "name": "capabilities",
          "description": "Reserved for features the client opts into. Currently ignored.",
          "schema": {
            "type": "object"
          }
        }
      ],
      "result": {
        "name": "session",
        "schema": {
          "$ref": "#/components/schemas/InitializeResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/AlreadyInitialized"
        }
      ],
      "examples": [
        {
          "name": "demo client",
          "params": [
            {
              "name": "protocolVersion",
              "value": "0.2.0"
            },
            {
              "name": "client",
              "value": {
                "name": "demo",
                "version": "1.0.0"
              }
            }
          ],
          "result": {
            "name": "session",
            "value": {
              "protocolVersion": "0.2.0",
              "server": {
                "name": "reasock",
                "version": "0.1.0"
              },
              "reaper": {
                "version": "7.78/macOS-arm64"
              },
              "connection": 1,
              "capabilities": {
                "actions": {
                  "register": true,
                  "run": true
                },
                "events": {
                  "available": [
                    "transport.changed",
                    "project.changed",
                    "project.edited",
                    "items.selectionChanged",
                    "tracks.selectionChanged"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "rpc.discover",
      "summary": "Get this document",
      "description": "Returns the OpenRPC document describing this server. Allowed before `initialize`.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "openrpcDocument",
        "schema": {
          "type": "object"
        }
      }
    },
    {
      "name": "action.register",
      "summary": "Add an action to REAPER's action list",
      "description": "Registers `_REASOCK_<client>_<id>` in the main section, labelled `ReaSock (<client>): <label>`. Users can bind it to keys, menus, and toolbars, and those bindings survive restarts. When it runs, this connection receives `action.triggered`. Registering an id this connection already owns returns the existing action. Actions are removed when the connection closes. Always refer to actions by `command`; `commandId` can change between REAPER sessions.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Name"
          }
        },
        {
          "name": "label",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "result": {
        "name": "action",
        "schema": {
          "$ref": "#/components/schemas/RegisteredAction"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        },
        {
          "$ref": "#/components/errors/ActionConflict"
        },
        {
          "$ref": "#/components/errors/RegistrationFailed"
        }
      ],
      "examples": [
        {
          "name": "hello action",
          "params": [
            {
              "name": "id",
              "value": "hello"
            },
            {
              "name": "label",
              "value": "Hello"
            }
          ],
          "result": {
            "name": "action",
            "value": {
              "command": "_REASOCK_demo_hello",
              "commandId": 55867
            }
          }
        }
      ]
    },
    {
      "name": "action.unregister",
      "summary": "Remove one of this connection's actions",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Name"
          }
        }
      ],
      "result": {
        "name": "empty",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        },
        {
          "$ref": "#/components/errors/UnknownAction"
        }
      ]
    },
    {
      "name": "action.run",
      "summary": "Run any main-section action",
      "description": "Runs a built-in action by numeric ID (for example `40182`, Item: Select all items) or any named action (for example `_SWS_ABOUT`, or one registered through ReaSock).",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "command",
          "required": true,
          "schema": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      ],
      "result": {
        "name": "ran",
        "schema": {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "integer"
            }
          },
          "required": [
            "commandId"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        },
        {
          "$ref": "#/components/errors/UnknownCommand"
        }
      ]
    },
    {
      "name": "events.subscribe",
      "summary": "Start receiving state-change notifications",
      "description": "Adds events to this connection's subscriptions, replacing the options of any it already has. Right after subscribing (or changing options), the connection receives the event once with the current state; after that, only when the state changes. State is checked about 30 times per second, and bursts of changes arrive as one notification per check. Collection events accept options; see `CollectionOptions`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "events",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subscription"
            },
            "minItems": 1
          }
        }
      ],
      "result": {
        "name": "subscriptions",
        "schema": {
          "$ref": "#/components/schemas/Subscriptions"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        }
      ],
      "examples": [
        {
          "name": "follow the selection",
          "params": [
            {
              "name": "events",
              "value": [
                "items.selectionChanged"
              ]
            }
          ],
          "result": {
            "name": "subscriptions",
            "value": {
              "events": [
                "items.selectionChanged"
              ]
            }
          }
        },
        {
          "name": "selection GUIDs only",
          "params": [
            {
              "name": "events",
              "value": [
                {
                  "event": "items.selectionChanged",
                  "options": {
                    "include": "none",
                    "limit": 1000
                  }
                }
              ]
            }
          ],
          "result": {
            "name": "subscriptions",
            "value": {
              "events": [
                "items.selectionChanged"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "events.unsubscribe",
      "summary": "Stop receiving notifications",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "events",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subscription"
            },
            "minItems": 1
          }
        }
      ],
      "result": {
        "name": "subscriptions",
        "schema": {
          "$ref": "#/components/schemas/Subscriptions"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        }
      ]
    },
    {
      "name": "items.listSelected",
      "summary": "Get the selected items, a page at a time",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "offset",
          "schema": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        {
          "name": "limit",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 256
          }
        }
      ],
      "result": {
        "name": "page",
        "schema": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "description": "Total selected items"
            },
            "offset": {
              "type": "integer"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Item"
              }
            }
          },
          "required": [
            "count",
            "offset",
            "items"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        }
      ]
    },
    {
      "name": "items.get",
      "summary": "Look up items by GUID",
      "description": "Searches the current project. Each result is in the same position as its GUID, or null if there is no such item. GUIDs compare case-insensitively.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "guids",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10000
          }
        }
      ],
      "result": {
        "name": "found",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Item"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "required": [
            "items"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        }
      ]
    },
    {
      "name": "tracks.listSelected",
      "summary": "Get the selected tracks, a page at a time",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "offset",
          "schema": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        {
          "name": "limit",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 256
          }
        }
      ],
      "result": {
        "name": "page",
        "schema": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "description": "Total selected tracks"
            },
            "offset": {
              "type": "integer"
            },
            "tracks": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Track"
              }
            }
          },
          "required": [
            "count",
            "offset",
            "tracks"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        }
      ]
    },
    {
      "name": "tracks.get",
      "summary": "Look up tracks by GUID",
      "description": "Searches the current project. Each result is in the same position as its GUID, or null if there is no such track. GUIDs compare case-insensitively.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "guids",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10000
          }
        }
      ],
      "result": {
        "name": "found",
        "schema": {
          "type": "object",
          "properties": {
            "tracks": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Track"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "required": [
            "tracks"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        }
      ]
    },
    {
      "name": "debug.stats",
      "summary": "Main-thread time spent on events",
      "description": "Reports how much of REAPER's main thread Tell is using: per timer tick (snapshots, comparisons, and serializing notifications), and per event. Times are in microseconds. Pass `reset: true` to start a new measurement window after reading.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "reset",
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "result": {
        "name": "stats",
        "schema": {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "number",
              "description": "Length of the measurement window"
            },
            "ticks": {
              "$ref": "#/components/schemas/Timing"
            },
            "events": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "check": {
                    "$ref": "#/components/schemas/Timing",
                    "description": "Cheap change check, every tick"
                  },
                  "snapshot": {
                    "$ref": "#/components/schemas/Timing",
                    "description": "Full snapshot, only when the check shows a change"
                  },
                  "compare": {
                    "$ref": "#/components/schemas/Timing"
                  },
                  "sent": {
                    "type": "integer",
                    "description": "Notifications queued, counting each recipient"
                  },
                  "lastBytes": {
                    "type": "integer",
                    "description": "Size of the most recent notification"
                  }
                }
              }
            }
          },
          "required": [
            "seconds",
            "ticks",
            "events"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NotInitialized"
        }
      ]
    }
  ],
  "x-notifications": [
    {
      "name": "action.triggered",
      "summary": "One of this connection's actions ran",
      "description": "Sent to the connection that registered the action, whether it ran from a key, a menu, the action list, or `action.run`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Name"
          }
        },
        {
          "name": "command",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "context",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ActionContext"
          }
        }
      ]
    },
    {
      "name": "transport.changed",
      "summary": "Play, pause, or record state changed",
      "description": "Subscribe with `events.subscribe`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "playing",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "paused",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "recording",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        }
      ]
    },
    {
      "name": "project.changed",
      "summary": "A different project is current, or the current one was saved or became dirty",
      "description": "Fires on tab switches, opening, saving, save-as, and the first edit after a save. `name` and `path` are null until the project is saved. Subscribe with `events.subscribe`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "tab",
          "required": true,
          "schema": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        {
          "name": "name",
          "required": true,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        {
          "name": "path",
          "required": true,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        {
          "name": "dirty",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        }
      ]
    },
    {
      "name": "project.edited",
      "summary": "An undoable change happened in the current project",
      "description": "`stateChangeCount` increases with every change; `lastUndo` describes the most recent undo point (for example \"Move media items\"). Subscribe with `events.subscribe`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "stateChangeCount",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "lastUndo",
          "required": true,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ]
    },
    {
      "name": "items.selectionChanged",
      "summary": "The item selection changed, or a selected item changed",
      "description": "Fires when items are selected or deselected, and when a selected item is moved, trimmed, or renamed (including live, while dragging). The first notification after subscribing lists every selected item as added. Subscribe with `events.subscribe`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "count",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "How many items are selected"
        },
        {
          "name": "added",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "GUIDs newly selected. Omitted, like `removed` and `changed`, when the change is larger than `limit`."
        },
        {
          "name": "removed",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "GUIDs no longer selected"
        },
        {
          "name": "changed",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "GUIDs still selected whose details changed"
        },
        {
          "name": "items",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "description": "Full entries, per the `include` option, in selection order"
        },
        {
          "name": "truncated",
          "required": true,
          "schema": {
            "type": "boolean"
          },
          "description": "Something this subscription asks for was left out because it exceeded `limit`. Call `items.listSelected` to catch up."
        }
      ]
    },
    {
      "name": "tracks.selectionChanged",
      "summary": "The track selection changed, or a selected track changed",
      "description": "Works like `items.selectionChanged`. The master track is never included. Subscribe with `events.subscribe`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "count",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "description": "How many tracks are selected"
        },
        {
          "name": "added",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "GUIDs newly selected. Omitted, like `removed` and `changed`, when the change is larger than `limit`."
        },
        {
          "name": "removed",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "GUIDs no longer selected"
        },
        {
          "name": "changed",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "GUIDs still selected whose details changed"
        },
        {
          "name": "tracks",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Track"
            }
          },
          "description": "Full entries, per the `include` option, in selection order"
        },
        {
          "name": "truncated",
          "required": true,
          "schema": {
            "type": "boolean"
          },
          "description": "Something this subscription asks for was left out because it exceeded `limit`. Call `tracks.listSelected` to catch up."
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "Name": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{1,32}$",
        "description": "Used inside REAPER command names, so only ASCII letters and digits."
      },
      "ClientInfo": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "InitializeResult": {
        "type": "object",
        "properties": {
          "protocolVersion": {
            "type": "string"
          },
          "server": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ]
          },
          "reaper": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              }
            },
            "required": [
              "version"
            ]
          },
          "connection": {
            "type": "integer"
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "actions": {
                "type": "object",
                "properties": {
                  "register": {
                    "type": "boolean"
                  },
                  "run": {
                    "type": "boolean"
                  }
                }
              },
              "events": {
                "type": "object",
                "properties": {
                  "available": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/EventName"
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "protocolVersion",
          "server",
          "reaper",
          "connection",
          "capabilities"
        ]
      },
      "RegisteredAction": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Named command, stable across sessions: `_REASOCK_<client>_<id>`."
          },
          "commandId": {
            "type": "integer",
            "description": "Numeric ID for this REAPER session only."
          }
        },
        "required": [
          "command",
          "commandId"
        ]
      },
      "ActionContext": {
        "type": "object",
        "properties": {
          "selectedItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "description": "Up to the first 256 selected items"
          },
          "selectedItemCount": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean",
            "description": "More items are selected than `selectedItems` holds; use `items.listSelected` for the rest."
          }
        },
        "required": [
          "selectedItems",
          "selectedItemCount",
          "truncated"
        ]
      },
      "EventName": {
        "type": "string",
        "enum": [
          "transport.changed",
          "project.changed",
          "project.edited",
          "items.selectionChanged",
          "tracks.selectionChanged"
        ]
      },
      "Subscriptions": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventName"
            }
          }
        },
        "required": [
          "events"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the active take"
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source file of the active take, or null for MIDI and empty items."
          },
          "track": {
            "type": [
              "string",
              "null"
            ],
            "description": "Track name"
          },
          "trackGuid": {
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "type": "number",
            "description": "Seconds"
          },
          "length": {
            "type": "number",
            "description": "Seconds"
          }
        },
        "required": [
          "guid",
          "name",
          "path",
          "track",
          "trackGuid",
          "position",
          "length"
        ],
        "description": "A media item. `guid` is stable across sessions."
      },
      "Track": {
        "type": "object",
        "description": "A track. `guid` is stable across sessions; `number` is the 1-based position shown in REAPER.",
        "properties": {
          "guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": "integer"
          }
        },
        "required": [
          "guid",
          "name",
          "number"
        ]
      },
      "Timing": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "avgUs": {
            "type": "integer"
          },
          "maxUs": {
            "type": "integer"
          }
        },
        "required": [
          "count",
          "avgUs",
          "maxUs"
        ]
      },
      "CollectionOptions": {
        "type": "object",
        "additionalProperties": false,
        "description": "Options for collection events (`items.selectionChanged`, `tracks.selectionChanged`). Notifications never carry more than `limit` GUIDs or entries; anything left out is flagged with `truncated`.",
        "properties": {
          "include": {
            "type": "string",
            "enum": [
              "none",
              "changed",
              "all"
            ],
            "default": "changed",
            "description": "Which full entries to send: none (GUIDs only), the added and changed ones, or the whole selection."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 256
          }
        }
      },
      "Subscription": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/EventName"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event": {
                "$ref": "#/components/schemas/EventName"
              },
              "options": {
                "$ref": "#/components/schemas/CollectionOptions"
              }
            },
            "required": [
              "event"
            ]
          }
        ]
      }
    },
    "errors": {
      "NotInitialized": {
        "code": -32001,
        "message": "call initialize first"
